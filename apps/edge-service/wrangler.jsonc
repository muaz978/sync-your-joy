{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sync-your-joy-rooms",
  "account_id": "40ae5b90cfe7a505dd1acc3f845ef3af",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    // Ask for new Durable Object code to be applied immediately. wrangler
    // 4.141.0 and later default to "deferred" with a 300 second wait on every
    // deploy and rollback. This is what is sent; on the real runtime an active
    // room was observed to keep the previous code for about 300 seconds in
    // either mode (docs/DURABLE_OBJECT_RUNTIME_OBSERVATIONS_2026-10-15.md), so
    // plan for that window. A room reconnects through its stored session
    // token and the coordinator repairs its state on restore.
    // Rollbacks must run with --config (npm run rollback:edge) or this is not
    // read.
    "code_update_strategy": {
      "mode": "immediate"
    },
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
