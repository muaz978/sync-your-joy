{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sync-your-joy-rooms",
  "account_id": "40ae5b90cfe7a505dd1acc3f845ef3af",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    // Apply new Durable Object code to running rooms immediately. wrangler
    // 4.141.0 and later default to "deferred" with a 300 second wait on every
    // deploy and rollback, which would leave old code serving live rooms (a
    // security fix would stay unapplied, a bad build would keep running) for up
    // to five minutes. A room reconnects through its stored session token, so
    // the brief interruption an immediate update causes is handled.
    // Rollbacks must run with --config (npm run rollback:edge) or this is not
    // read.
    "code_update_strategy": {
      "mode": "immediate"
    },
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },
  "exports": {
    "RoomDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
