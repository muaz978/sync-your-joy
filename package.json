{
  "name": "sync-your-joy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "build:server": "esbuild apps/room-service/src/server.ts --bundle --platform=node --format=esm --outfile=apps/room-service/dist/server.mjs --external:ws",
    "dev:server": "tsx apps/room-service/src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@unocss/preset-wind4": "^66.7.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "unocss": "^66.7.5",
    "vitest": "^4.1.10"
  }
}
